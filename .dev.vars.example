# Copy this file to ".dev.vars" for local development with `wrangler pages dev`.
# ".dev.vars" is gitignored — never commit real secrets.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=bookings@yourdomain.com
OWNER_EMAIL=you@yourdomain.com
BUSINESS_NAME=Serene Studio
